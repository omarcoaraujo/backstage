{
  "name": "Backstage",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "backstage": { "$path": "src" },
      "roblox_packages": { "$path": "roblox_packages" },
      "data": { "$path": "example/data/shared" },
      "ui": { "$path": "example/ui" },
      "client_modules": { "$path": "example/client" },
      "stories": { "$path": "stories" }
    },

    "Workspace": {
      "$className": "Workspace",
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [512, 4, 512],
          "Position": [0, -2, 0]
        }
      }
    },

    "ServerScriptService": {
      "server": { "$path": "example/.server.luau" }
    },
    
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "client": { "$path": "example/.client.luau" }
      }
    }
  }
}
